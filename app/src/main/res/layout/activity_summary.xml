<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Podsumowanie zamówienia"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/textViewSummaryCustomer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Klient: "
        android:textSize="16sp" />

    <TextView
        android:id="@+id/textViewSummarySize"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rozmiar: "
        android:textSize="16sp"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/textViewSummaryCheese"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dodatkowy ser: "
        android:textSize="16sp"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/buttonBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Wróć / Potwierdź" />

</LinearLayout>